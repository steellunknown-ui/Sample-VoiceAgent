# ==============================================================================
# Voice Agent — Environment Configuration Template
# (Copy this file to .env and fill in your actual API keys)
# NEVER commit your real .env file with secrets to GitHub!
# ==============================================================================

# OpenRouter API Key (Get a free key at: https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model (Free options available on OpenRouter)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Agent Name
AGENT_NAME=Aria

# TTS Mode: auto | sarvam | elevenlabs | edge
# auto = ElevenLabs for English, Sarvam for Hinglish/Marathi, with Edge-TTS fallback
TTS_PROVIDER=auto

# Sarvam.ai API Key (Native Indian neural TTS & STT: https://sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_SPEAKER=ashutosh

# ElevenLabs API Key (Hyper-realistic expressive voices: https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# George voice ID (or Adam: pNInz6obpgDQGcFmaJgB, or your custom cloned voice ID):
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Edge-TTS Fallback Voice Settings (100% free fallback - Indian Neural Voices)
TTS_VOICE_EN=en-IN-PrabhatNeural
TTS_VOICE_HI=hi-IN-MadhurNeural
TTS_VOICE_MR=mr-IN-AarohiNeural

# Speech rate and pitch adjustments
TTS_RATE=+10%
TTS_PITCH=+0Hz

# Whisper STT model size: tiny, base, small, medium
WHISPER_MODEL=base

# Server configuration
HOST=0.0.0.0
PORT=5000
